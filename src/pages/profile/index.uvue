<template>
  <scroll-view class="profile-page" direction="vertical">
    <view class="profile-content">
      <text class="profile-eyebrow">个人中心</text>
      <view class="profile-hero">
        <view class="avatar"><text class="avatar-letter">{{ avatarLetter }}</text></view>
        <view class="identity"><text class="account-name">{{ displayName }}</text><text class="account-subtitle">{{ account }}</text></view>
      </view>

      <view class="account-card">
        <text class="card-title">账户资料</text>
        <view v-if="loading" class="account-row"><text class="account-value">正在读取账户资料…</text></view>
        <view v-else-if="errorText != ''" class="account-row"><text class="account-value">{{ errorText }}</text><text class="retry-link" @tap="loadProfile">重试</text></view>
        <view v-else>
          <view class="account-row"><text class="account-label">邮箱</text><text class="account-value">{{ profile.email ?? '未绑定' }}</text></view>
          <view class="account-row"><text class="account-label">手机号</text><text class="account-value">{{ profile.phone ?? '未绑定' }}</text></view>
        </view>
      </view>

      <view class="action-card" @tap="openAgreement"><text class="action-title">用户协议与隐私协议</text><text class="action-arrow">›</text></view>
      <button class="logout-button" @tap="logout">退出登录</button>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { onShow } from '@dcloudio/uni-app'
import { computed, ref } from 'vue'
import { clearAuthToken, getAccountLabel, getAuthToken } from '../../auth/session'
import { http } from '../../http'

type UserProfile = { username?: string; nickname?: string; email?: string; phone?: string }
type ProfileResponse = { code: number; data?: UserProfile | null; msg?: string | null }
const account = ref('')
const profile = ref<UserProfile>({})
const loading = ref(false)
const errorText = ref('')
const displayName = computed((): string => {
  const nickname = profile.value.nickname ?? ''
  if (nickname != '') return nickname
  const username = profile.value.username ?? ''
  return username != '' ? username : '清新记账用户'
})
const avatarLetter = computed((): string => displayName.value.substring(0, 1))
onShow(() => {
  if (getAuthToken() == '') {
    uni.reLaunch({ url: '/src/pages/auth/login' })
    return
  }
  account.value = getAccountLabel()
  loadProfile()
})
async function loadProfile(): Promise<void> {
  loading.value = true
  errorText.value = ''
  try {
    const response = await http.Get<ProfileResponse>('/user/detail')
    if (response.code != 1 || response.data == null) throw new Error(response.msg ?? '账户资料加载失败')
    profile.value = response.data as UserProfile
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '账户资料加载失败'
  } finally {
    loading.value = false
  }
}
function openAgreement(): void { uni.navigateTo({ url: '/src/pages/auth/agreement' }) }
function logout(): void {
  clearAuthToken()
  uni.reLaunch({ url: '/src/pages/auth/login' })
}
</script>

<style>
.profile-page { flex: 1; background-image: linear-gradient(to bottom, #e2d8ff, #f4effb 47%, #f7f8fa 76%); }
.profile-content { padding: 67px 17px 38px; }
.profile-eyebrow { color: #665c78; font-size: 13px; margin-bottom: 20px; }
.profile-hero { flex-direction: row; align-items: center; margin-bottom: 28px; }
.avatar { width: 59px; height: 59px; border-radius: 19px; background-color: #7954df; align-items: center; justify-content: center; margin-right: 14px; border-width: 2px; border-color: rgba(255,255,255,0.72); }
.avatar-letter { color: #ffffff; font-size: 25px; font-weight: 700; }
.identity { flex: 1; }
.account-name { color: #2f2545; font-size: 21px; font-weight: 800; }
.account-subtitle { color: #897e9b; font-size: 12px; margin-top: 5px; }
.account-card { padding: 19px 18px 4px; background-color: rgba(255,255,255,0.82); border-radius: 19px; margin-bottom: 12px; }
.card-title { color: #332949; font-size: 15px; font-weight: 800; margin-bottom: 9px; }
.account-row { flex-direction: row; align-items: center; justify-content: space-between; min-height: 52px; border-bottom-width: 1px; border-bottom-color: #f0edf6; }
.account-label { color: #554b66; font-size: 13px; }
.account-value { color: #8b8299; font-size: 12px; }
.retry-link { color: #7050cd; font-size: 12px; font-weight: 700; }
.action-card { flex-direction: row; align-items: center; padding: 17px 19px; background-color: rgba(255,255,255,0.82); border-radius: 17px; margin-bottom: 18px; }
.action-title { flex: 1; color: #3f354f; font-size: 14px; font-weight: 600; }
.action-arrow { color: #9a8cab; font-size: 22px; }
.logout-button { width: 100%; height: 48px; line-height: 48px; background-color: rgba(255,255,255,0.87); color: #cb506c; font-size: 14px; font-weight: 600; border-radius: 14px; }
</style>
