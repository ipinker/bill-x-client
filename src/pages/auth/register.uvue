<template>
  <view class="register-shell">
    <image class="register-background" src="/static/images/auth-mist.png" mode="aspectFill" />
    <scroll-view class="register-page" direction="vertical">
      <view class="register-content">
        <view class="back-button" @tap="goBack"><text class="back-arrow">←</text><text class="back-label">返回登录</text></view>
        <view class="brand-row">
          <image class="brand-mark" src="/static/images/auth-logo.png" mode="aspectFit" />
          <image class="brand-name" src="/static/images/auth-title.png" mode="aspectFit" />
        </view>
        <text class="page-title">开启新的记账日常</text>
        <text class="page-subtitle">一个账户，轻松收好生活的每一笔</text>

      <view class="register-card">
        <view class="channel-row">
          <view class="channel-indicator" :style="isPhone ? 'transform: translateX(104px)' : 'transform: translateX(0px)'" />
          <text :class="isPhone ? 'channel-label channel-idle' : 'channel-label channel-active'" @tap="setPhone(false)">✉ 邮箱</text>
          <text :class="isPhone ? 'channel-label channel-active' : 'channel-label channel-idle'" @tap="setPhone(true)">✆ 手机号</text>
        </view>
        <text class="field-label">{{ isPhone ? '手机号码' : '邮箱地址' }}</text>
        <input v-model="account" class="field-input" :type="isPhone ? 'number' : 'text'" :placeholder="isPhone ? '请输入手机号' : '请输入邮箱地址'" />
        <text class="field-label">验证码</text>
        <view class="code-row">
          <input v-model="code" class="field-input code-input" type="number" placeholder="请输入验证码" />
          <text class="send-code" @tap="sendCode">{{ countdown > 0 ? `${countdown}s` : '获取验证码' }}</text>
        </view>
        <text class="field-label">密码（选填）</text>
        <input v-model="password" class="field-input" type="password" placeholder="至少 6 位，留空也可注册" />
        <text class="hint-text">不设置密码也可通过验证码登录；设置后可使用邮箱密码登录。</text>
        <text v-if="errorText != ''" class="error-text">{{ errorText }}</text>
        <button class="primary-button" :disabled="busy" @tap="submit">{{ busy ? '创建中…' : '注册并登录' }}</button>
      </view>
      <view class="agreement-row">
        <view :class="agreed ? 'agree-check agree-checked' : 'agree-check'" @tap="agreed = !agreed">
          <text v-if="agreed" class="agree-tick">✓</text>
        </view>
        <text class="agree-copy" @tap="agreed = !agreed">我已阅读并同意</text>
        <text class="agree-link" @tap="openAgreement">《用户协议》</text>
        <text class="agree-copy">与</text>
        <text class="agree-link" @tap="openAgreement">《隐私协议》</text>
      </view>
      <text class="footer-note">好好生活，慢慢记账。</text>
    </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { onUnmounted, ref } from 'vue'
import { registerWithCode, sendAuthCode } from '../../auth/api'

const isPhone = ref(false)
const account = ref('')
const code = ref('')
const password = ref('')
const errorText = ref('')
const busy = ref(false)
const agreed = ref(false)
const countdown = ref(0)
let countdownTimer: number = -1

onUnmounted(() => { if (countdownTimer != -1) clearInterval(countdownTimer) })

function goBack(): void { uni.navigateBack() }
function openAgreement(): void { uni.navigateTo({ url: '/src/pages/auth/agreement' }) }
function setPhone(next: boolean): void {
  isPhone.value = next
  account.value = ''
  errorText.value = ''
}
function validAccount(): boolean {
  const value = account.value.trim()
  return isPhone.value ? /^1\d{10}$/.test(value) : /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)
}
function startCountdown(): void {
  countdown.value = 60
  if (countdownTimer != -1) clearInterval(countdownTimer)
  countdownTimer = setInterval(() => {
    countdown.value -= 1
    if (countdown.value <= 0) {
      clearInterval(countdownTimer)
      countdownTimer = -1
    }
  }, 1000) as number
}
async function sendCode(): Promise<void> {
  if (busy.value || countdown.value > 0) return
  if (!validAccount()) {
    errorText.value = isPhone.value ? '请输入正确的手机号' : '请输入正确的邮箱地址'
    return
  }
  busy.value = true
  errorText.value = ''
  try {
    await sendAuthCode(account.value.trim(), isPhone.value)
    startCountdown()
    uni.showToast({ title: '验证码已发送', icon: 'none' })
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '发送失败，请重试'
  } finally {
    busy.value = false
  }
}
async function submit(): Promise<void> {
  if (busy.value) return
  if (!agreed.value) {
    errorText.value = '请先阅读并同意用户协议与隐私协议'
    return
  }
  if (!validAccount()) {
    errorText.value = isPhone.value ? '请输入正确的手机号' : '请输入正确的邮箱地址'
    return
  }
  if (code.value.trim() == '') {
    errorText.value = '请输入验证码'
    return
  }
  if (password.value != '' && password.value.length < 6) {
    errorText.value = '密码至少 6 位，或留空'
    return
  }
  busy.value = true
  errorText.value = ''
  try {
    await registerWithCode(account.value.trim(), code.value.trim(), password.value, isPhone.value)
    uni.switchTab({ url: '/src/pages/home/index' })
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '注册失败，请重试'
  } finally {
    busy.value = false
  }
}
</script>

<style>
.register-shell { flex: 1; background-color: #ece8ff; }
.register-background { position: absolute; width: 100%; height: 100%; }
.register-page { flex: 1; }
.register-content { padding: 52px 24px 32px; }
.back-button { flex-direction: row; align-items: center; justify-content: center; width: 116px; height: 38px; border-radius: 19px; background-color: rgba(255,255,255,0.58); border-width: 1px; border-color: rgba(255,255,255,0.8); margin-bottom: 21px; }
.back-arrow { color: #6746c0; font-size: 19px; font-weight: 700; margin-right: 6px; }
.back-label { color: #6746c0; font-size: 13px; font-weight: 700; }
.brand-row { flex-direction: row; align-items: center; margin-bottom: 23px; }
.brand-mark { width: 40px; height: 40px; margin-right: 10px; }
.brand-name { width: 98px; height: 26px; }
.page-title { color: #281a49; font-size: 27px; font-weight: 800; }
.page-subtitle { color: #675a80; font-size: 12px; margin-top: 8px; margin-bottom: 20px; }
.register-card { padding: 19px 20px 20px; border-radius: 24px; background-image: linear-gradient(to bottom, rgba(255,255,255,0.86), rgba(255,255,255,0.61)); border-width: 1px; border-color: rgba(255,255,255,0.95); box-shadow: 0 14px 36px rgba(80,54,139,0.15); }
.channel-row { position: relative; flex-direction: row; width: 214px; height: 35px; padding: 3px; border-radius: 11px; background-color: rgba(231,224,249,0.72); margin-bottom: 8px; }
.channel-indicator { position: absolute; left: 3px; top: 3px; width: 104px; height: 29px; border-radius: 8px; background-color: #ffffff; box-shadow: 0 2px 8px rgba(90,65,150,0.14); transition-property: transform; transition-duration: 0.22s; }
.channel-label { width: 104px; height: 29px; line-height: 29px; text-align: center; font-size: 12px; font-weight: 600; transition-property: color; transition-duration: 0.22s; }
.channel-active { color: #6845c6; }
.channel-idle { color: #8d829f; }
.field-label { color: #51446c; font-size: 13px; font-weight: 600; margin-bottom: 7px; margin-top: 10px; }
.field-input { height: 45px; background-color: rgba(247,245,251,0.85); border-radius: 12px; padding: 0 14px; color: #281a49; font-size: 15px; }
.code-row { flex-direction: row; align-items: center; }
.code-input { flex: 1; }
.send-code { color: #6947c7; font-size: 12px; font-weight: 600; margin-left: 10px; }
.hint-text { color: #8b819e; font-size: 12px; line-height: 18px; margin-top: 8px; }
.error-text { color: #d4476b; font-size: 12px; margin-top: 10px; }
.primary-button { margin-top: 19px; width: 100%; height: 46px; line-height: 46px; border-radius: 13px; background-color: #6e4bd2; color: #ffffff; font-size: 16px; font-weight: 700; }
.agreement-row { flex-direction: row; align-items: center; justify-content: center; margin-top: 23px; }
.agree-check { width: 17px; height: 17px; border-radius: 5px; border-width: 1px; border-color: #947acb; background-color: rgba(255,255,255,0.55); margin-right: 6px; align-items: center; justify-content: center; }
.agree-checked { background-color: #7452cc; border-color: #7452cc; }
.agree-tick { color: #ffffff; font-size: 12px; font-weight: 800; }
.agree-copy { color: #6e6483; font-size: 10px; }
.agree-link { color: #6743c3; font-size: 10px; font-weight: 700; }
.footer-note { color: #87799c; font-size: 11px; text-align: center; margin-top: 18px; }
</style>
