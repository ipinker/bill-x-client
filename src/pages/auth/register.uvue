<template>
  <scroll-view class="register-page" direction="vertical">
    <view class="register-content">
      <text class="back-link" @tap="goBack">‹ 返回登录</text>
      <text class="page-title">创建账户</text>
      <text class="page-subtitle">先验证邮箱，也可以使用手机号</text>

      <view class="register-card">
        <view class="channel-row">
          <text :class="isPhone ? 'channel-idle' : 'channel-active'" @tap="setPhone(false)">邮箱注册</text>
          <text :class="isPhone ? 'channel-active' : 'channel-idle'" @tap="setPhone(true)">手机注册</text>
        </view>
        <text class="field-label">{{ isPhone ? '手机号码' : '邮箱地址' }}</text>
        <input v-model="account" class="field-input" :type="isPhone ? 'number' : 'text'" :placeholder="isPhone ? '请输入手机号' : '请输入邮箱地址'" />
        <text class="field-label">验证码</text>
        <view class="code-row">
          <input v-model="code" class="field-input code-input" type="number" placeholder="请输入验证码" />
          <text class="send-code" @tap="sendCode">{{ countdown > 0 ? `${countdown}s` : '获取验证码' }}</text>
        </view>
        <text class="field-label">密码（选填）</text>
        <input v-model="password" class="field-input" type="password" placeholder="至少 6 位，留空也可注册" />
        <text class="hint-text">不设置密码也可通过验证码登录；设置后可使用邮箱密码登录。</text>
        <text v-if="errorText != ''" class="error-text">{{ errorText }}</text>
        <button class="primary-button" :disabled="busy" @tap="submit">{{ busy ? '创建中…' : '注册并进入首页' }}</button>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { onUnmounted, ref } from 'vue'
import { registerWithCode, sendAuthCode } from '../../auth/api'

const isPhone = ref(false)
const account = ref('')
const code = ref('')
const password = ref('')
const errorText = ref('')
const busy = ref(false)
const countdown = ref(0)
let countdownTimer: number = -1

onUnmounted(() => { if (countdownTimer != -1) clearInterval(countdownTimer) })

function goBack(): void { uni.navigateBack() }
function setPhone(next: boolean): void {
  isPhone.value = next
  account.value = ''
  errorText.value = ''
}
function validAccount(): boolean {
  const value = account.value.trim()
  return isPhone.value ? /^1\d{10}$/.test(value) : /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)
}
function startCountdown(): void {
  countdown.value = 60
  if (countdownTimer != -1) clearInterval(countdownTimer)
  countdownTimer = setInterval(() => {
    countdown.value -= 1
    if (countdown.value <= 0) {
      clearInterval(countdownTimer)
      countdownTimer = -1
    }
  }, 1000) as number
}
async function sendCode(): Promise<void> {
  if (busy.value || countdown.value > 0) return
  if (!validAccount()) {
    errorText.value = isPhone.value ? '请输入正确的手机号' : '请输入正确的邮箱地址'
    return
  }
  busy.value = true
  errorText.value = ''
  try {
    await sendAuthCode(account.value.trim(), isPhone.value)
    startCountdown()
    uni.showToast({ title: '验证码已发送', icon: 'none' })
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '发送失败，请重试'
  } finally {
    busy.value = false
  }
}
async function submit(): Promise<void> {
  if (busy.value) return
  if (!validAccount()) {
    errorText.value = isPhone.value ? '请输入正确的手机号' : '请输入正确的邮箱地址'
    return
  }
  if (code.value.trim() == '') {
    errorText.value = '请输入验证码'
    return
  }
  if (password.value != '' && password.value.length < 6) {
    errorText.value = '密码至少 6 位，或留空'
    return
  }
  busy.value = true
  errorText.value = ''
  try {
    await registerWithCode(account.value.trim(), code.value.trim(), password.value, isPhone.value)
    uni.switchTab({ url: '/src/pages/home/index' })
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '注册失败，请重试'
  } finally {
    busy.value = false
  }
}
</script>

<style>
.register-page { flex: 1; background-color: #f8f6fc; }
.register-content { padding: 58px 22px 36px; }
.back-link { color: #7050e8; font-size: 14px; margin-bottom: 38px; }
.page-title { color: #261d42; font-size: 28px; font-weight: 800; }
.page-subtitle { color: #8b849b; font-size: 14px; margin-top: 8px; margin-bottom: 30px; }
.register-card { padding: 24px; border-radius: 22px; background-color: #ffffff; }
.channel-row { flex-direction: row; border-bottom-width: 1px; border-bottom-color: #ece8f6; margin-bottom: 16px; }
.channel-active { color: #7050e8; font-size: 15px; font-weight: 700; padding: 0 12px 12px; border-bottom-width: 2px; border-bottom-color: #7050e8; }
.channel-idle { color: #8b849b; font-size: 15px; padding: 0 12px 12px; }
.field-label { color: #524968; font-size: 13px; font-weight: 600; margin-bottom: 7px; margin-top: 14px; }
.field-input { height: 50px; background-color: #f7f5fc; border-radius: 12px; padding: 0 14px; color: #261d42; font-size: 15px; }
.code-row { flex-direction: row; align-items: center; }
.code-input { flex: 1; }
.send-code { color: #7050e8; font-size: 13px; font-weight: 700; margin-left: 12px; }
.hint-text { color: #8b849b; font-size: 12px; line-height: 19px; margin-top: 10px; }
.error-text { color: #db4764; font-size: 12px; margin-top: 12px; }
.primary-button { margin-top: 26px; width: 100%; height: 50px; line-height: 50px; border-radius: 14px; background-color: #7050e8; color: #ffffff; font-size: 16px; font-weight: 700; }
</style>
