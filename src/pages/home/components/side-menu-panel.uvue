      @touchmove="onTouchMove"
      @touchend="onTouchEnd"
      @touchcancel="onTouchEnd"
    >
      <view class="side-menu-statusbar"></view>
      <view class="side-menu-header">
        <view class="side-menu-user" @tap="emitProfile">
