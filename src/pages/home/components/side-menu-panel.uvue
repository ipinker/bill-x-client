            </view>
            <view class="side-menu-item side-menu-item-second" @tap="emitAssets">
              <image class="side-menu-item-icon" src="/static/images/side-menu/icon_assets@3x.png" mode="aspectFit" />
              <text class="side-menu-item-text">我的資產</text>
              <image class="side-menu-menu-arrow" src="/static/images/side-menu/icon_menu_arrow@3x.png" mode="aspectFit" />
            </view>
            <view class="side-menu-item side-menu-item-third" @tap="emitInvite">
              <image class="side-menu-item-icon" src="/static/images/side-menu/icon_invite@3x.png" mode="aspectFit" />
              <text class="side-menu-item-text">我的邀請碼</text>
              <image class="side-menu-menu-arrow" src="/static/images/side-menu/icon_menu_arrow@3x.png" mode="aspectFit" />
            </view>
          </view>

