      </scroll-view>
    </view>
    <view :class="visible ? 'side-menu-mask side-menu-mask-open' : 'side-menu-mask'" @tap="emitClose"></view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref, watch } from 'vue'

const props = defineProps({
  show: {
    type: Boolean,
    default: false,
  },
  panelWidth: {
    type: Number,
    default: 280,
  },
  displayName: {
    type: String,
    default: 'KoKo 用户',
  },
  avatarUrl: {
    type: String,
    default: '/static/logo.png',
  },
  unreadCount: {
    type: Number,
    default: 0,
  },
  benefitText: {
    type: String,
    default: '0',
  },
  adImageUrl: {
    type: String,
    default: '',
  },
})

const SIDE_MENU_TRANSITION_DURATION = 260
const rendered = ref(false)
const visible = ref(false)
const hideTimer = ref<number | null>(null)
const isDragging = ref(false)
const dragStartX = ref(0)
const dragStartY = ref(0)
const dragOffset = ref(0)
const isVerticalGesture = ref(false)

const panelStyle = computed(() : UTSJSONObject => {
  const style = {
    width: `${Math.max(280, props.panelWidth)}px`,
  } as UTSJSONObject
  if (isDragging.value) {
    style['transform'] = `translateX(${dragOffset.value}px)`
  }
  return style
})

const panelClass = computed(() : string => {
  const visibleClass = visible.value ? ' side-menu-panel-open' : ''
  const draggingClass = isDragging.value ? ' side-menu-panel-dragging' : ''
  return `side-menu-panel${visibleClass}${draggingClass}`
})

const emit = defineEmits([
  'close',
  'profile',
  'message',
  'scan',
  'coupon-center',
  'dmc-report',
  'register',
  'appointment',
  'assets',
  'schedule',
  'health-record',
  'follow-up',
   'invite',
   'vip-center',
   'ad',
   'short-video',
])

function emitClose() : void {
  emit('close')
}

function emitProfile() : void {
  emit('profile')
}

function emitMessage() : void {
  emit('message')
}

function emitScan() : void {
  emit('scan')
}

function emitCouponCenter() : void {
  emit('coupon-center')
}

function emitDmcReport() : void {
  emit('dmc-report')
}

function emitRegister() : void {
  emit('register')
}

function emitAppointment() : void {
  emit('appointment')
}

function emitAssets() : void {
  emit('assets')
}

function emitSchedule() : void {
  emit('schedule')
}

function emitHealthRecord() : void {
  emit('health-record')
}

function emitFollowUp() : void {
  emit('follow-up')
}

function emitInvite() : void {
  emit('invite')
}

function emitVipCenter() : void {
  emit('vip-center')
}

function emitAd() : void {
  emit('ad')
}

function emitShortVideo() : void {
  emit('short-video')
}

function getTouchPageX(event : UniTouchEvent) : number | null {
  if (event.changedTouches.length > 0) {
    return event.changedTouches[0].pageX
  }
  if (event.touches.length > 0) {
    return event.touches[0].pageX
  }
  return null
}

function getTouchPageY(event : UniTouchEvent) : number | null {
  if (event.changedTouches.length > 0) {
    return event.changedTouches[0].pageY
  }
  if (event.touches.length > 0) {
    return event.touches[0].pageY
  }
  return null
}

function onTouchStart(event : UniTouchEvent) : void {
  const pageX = getTouchPageX(event)
  const pageY = getTouchPageY(event)
  if (pageX == null || pageY == null) {
    return
  }
  isDragging.value = false
  isVerticalGesture.value = false
  dragStartX.value = pageX
  dragStartY.value = pageY
  dragOffset.value = 0
}

function onTouchMove(event : UniTouchEvent) : void {
  const pageX = getTouchPageX(event)
  const pageY = getTouchPageY(event)
  if (pageX == null || pageY == null) {
    return
  }
  const nextOffset = pageX - dragStartX.value
  const verticalOffset = pageY - dragStartY.value
  if (!isDragging.value && !isVerticalGesture.value) {
    if (Math.abs(nextOffset) < 8 && Math.abs(verticalOffset) < 8) {
      return
    }
    if (nextOffset >= 0 || Math.abs(nextOffset) <= Math.abs(verticalOffset)) {
      isVerticalGesture.value = true
      return
    }
    isDragging.value = true
  }
  if (!isDragging.value) {
    return
  }
  dragOffset.value = Math.min(0, Math.max(-Math.max(280, props.panelWidth), nextOffset))
}

function onTouchEnd() : void {
  if (!isDragging.value) {
    isVerticalGesture.value = false
    return
  }
  const shouldClose = dragOffset.value < -Math.max(280, props.panelWidth) / 2
  isDragging.value = false
  isVerticalGesture.value = false
  dragOffset.value = 0
  if (shouldClose) {
    emitClose()
  }
}

function clearHideTimer() : void {
  const timer = hideTimer.value
  if (timer != null) {
    clearTimeout(timer)
    hideTimer.value = null
  }
}

function openPanel() : void {
  clearHideTimer()
  rendered.value = true
  setTimeout(() => {
    visible.value = true
  }, 20)
}

function closePanel() : void {
  if (!rendered.value) {
    return
  }
  visible.value = false
  clearHideTimer()
  hideTimer.value = setTimeout(() => {
    rendered.value = false
    clearHideTimer()
  }, SIDE_MENU_TRANSITION_DURATION)
}

watch(() : boolean => {
  return props.show
}, (value : boolean) => {
  if (value) {
    openPanel()
    return
  }
  closePanel()
}, {
  immediate: true,
})
</script>

