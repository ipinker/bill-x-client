              <text class="side-menu-benefit-desc side-menu-benefit-coupon-desc">限時優惠 即刻領取</text>
              <image class="side-menu-benefit-arrow" src="/static/images/side-menu/icon_coupon_arrow@3x.png" mode="aspectFit" />
              <image class="side-menu-benefit-art side-menu-benefit-coupon-art" src="/static/images/side-menu/img_coupon_center@3x.png" mode="aspectFit" />
            </view>
          </view>

          <text class="side-menu-section-title">健康管理</text>
          <view class="side-menu-health-card">
            <view class="side-menu-health-primary-row">
              <view class="side-menu-health-primary" @tap="emitHealthRecord">
                <image class="side-menu-health-primary-icon" src="/static/images/side-menu/icon_health_record@3x.png" mode="aspectFit" />
                <text class="side-menu-health-primary-title">健康紀錄</text>
                <text class="side-menu-health-primary-desc">資料與趨勢</text>
              </view>
              <view class="side-menu-health-primary" @tap="emitDmcReport">
                <image class="side-menu-health-primary-icon" src="/static/images/side-menu/icon_dmc_report@3x.png" mode="aspectFit" />
                <text class="side-menu-health-primary-title">四診報告</text>
                <text class="side-menu-health-primary-desc">查看報告</text>
              </view>
              <view class="side-menu-health-primary" @tap="emitRegister">
                <image class="side-menu-health-primary-icon" src="/static/images/side-menu/icon_offline_register@3x.png" mode="aspectFit" />
                <text class="side-menu-health-primary-title">線下掛號</text>
                <text class="side-menu-health-primary-desc">快速掛號</text>
              </view>
            </view>
            <view class="side-menu-health-divider"></view>
            <view class="side-menu-health-secondary-row">
              <view class="side-menu-health-secondary" @tap="emitFollowUp">
                <image class="side-menu-health-secondary-icon" src="/static/images/side-menu/icon_follow_up@3x.png" mode="aspectFit" />
                <view class="side-menu-health-secondary-meta">
