            <view v-else class="side-menu-ad-placeholder">
              <view class="side-menu-ad-copy">
                <text class="side-menu-ad-title">我是一個廣告</text>
                <text class="side-menu-ad-desc">會員年卡限時 50%</text>
              </view>
              <image class="side-menu-ad-art" src="/static/images/side-menu/img_ad_gift@3x.png" mode="aspectFit" />
            </view>
          </view>
