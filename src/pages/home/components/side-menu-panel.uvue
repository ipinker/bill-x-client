            <image class="side-menu-short-video-icon" src="/static/images/side-menu/icon_dmc_report@3x.png" mode="aspectFit" />
            <text class="side-menu-short-video-text">短剧</text>
            <image class="side-menu-short-video-arrow" src="/static/images/side-menu/icon_menu_arrow@3x.png" mode="aspectFit" />
