              <image class="side-menu-benefit-art side-menu-benefit-koko-art" src="/static/images/side-menu/img_koko_base@3x.png" mode="aspectFit" />
            </view>
            <view class="side-menu-benefit-card side-menu-benefit-coupon" @tap="emitCouponCenter">
