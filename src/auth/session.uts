const TOKEN_STORAGE_KEY = 'x_client_auth_token'
const ACCOUNT_STORAGE_KEY = 'x_client_account'

export function getAuthToken(): string {
  const value = uni.getStorageSync(TOKEN_STORAGE_KEY)
  return typeof value == 'string' ? value as string : ''
}

export function saveAuthToken(token: string): void {
  uni.setStorageSync(TOKEN_STORAGE_KEY, token)
}

export function getAccountLabel(): string {
  const value = uni.getStorageSync(ACCOUNT_STORAGE_KEY)
  return typeof value == 'string' ? value as string : ''
}

export function saveAccountLabel(value: string): void {
  uni.setStorageSync(ACCOUNT_STORAGE_KEY, value)
}

export function clearAuthToken(): void {
  uni.removeStorageSync(TOKEN_STORAGE_KEY)
  uni.removeStorageSync(ACCOUNT_STORAGE_KEY)
}
