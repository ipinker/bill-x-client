	$x-loading-circle-border-bottom-left-radius: 100px !default;
	$x-loading-circle-border-bottom-right-radiu: 100px !default;
	$x-loading-circle-border-width:2px !default;
	$x-loading-circle-border-top-color:#e5e5e5 !default;
	$x-loading-circle-border-right-color:$x-loading-circle-border-top-color !default;
	$x-loading-circle-border-bottom-color:$x-loading-circle-border-top-color !default;
	$x-loading-circle-border-left-color:$x-loading-circle-border-top-color !default;
	$x-loading-circle-border-style:solid !default;
	$x-loading-icon-host-font-size:0px !default;
	$x-loading-icon-host-line-height:1 !default;
	$x-loading-icon-vertical-margin:6px 0 0 !default;
	$x-loading-icon-dot-top:0 !default;
	$x-loading-icon-dot-left:0 !default;
	$x-loading-icon-dot-width:100% !default;
	$x-loading-icon-dot-height:100% !default;
	$x-loading-icon-dot-before-width:2px !default;
	$x-loading-icon-dot-before-height:25% !default;
	$x-loading-icon-dot-before-margin:0 auto !default;
	$x-loading-icon-dot-before-background-color: #ffffff !default;
	$x-loading-icon-dot-before-border-radius:8px !default;

	.x-loading-icon {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		// color: $x-loading-icon-color;

		&__text {
			margin-left: $x-loading-icon-text-margin-left;
			color: $x-loading-icon-text-color;
			font-size: $x-loading-icon-text-font-size;
			line-height: $x-loading-icon-text-line-height;
		}

		&__spinner {
			width: $x-loading-width;
			height: $x-loading-height;
			position: relative;
			box-sizing: border-box;
			// max-width: $x-loading-max-width;
			// max-height: $x-loading-max-height;
			// animation: x-rotate 1s linear infinite;
		}

		&__spinner--semicircle {
			border-width: $x-loading-semicircle-border-width;
			border-color: $x-loading-semicircle-border-color;
			border-top-right-radius: $x-loading-semicircle-border-top-right-radius;
			border-top-left-radius: $x-loading-semicircle-border-top-left-radius;
			border-bottom-left-radius: $x-loading-semicircle-border-bottom-left-radius;
			border-bottom-right-radius: $x-loading-semicircle-border-bottom-right-radiu;
			border-style: $x-loading-semicircle-border-style;
		}

		&__spinner--circle {
			border-top-right-radius: $x-loading-circle-border-top-right-radius;
			border-top-left-radius: $x-loading-circle-border-top-left-radius;
			border-bottom-left-radius: $x-loading-circle-border-bottom-left-radius;
			border-bottom-right-radius: $x-loading-circle-border-bottom-right-radiu;
			border-width: $x-loading-circle-border-width;
			border-top-color: $x-loading-circle-border-top-color;
			border-right-color: $x-loading-circle-border-right-color;
			border-bottom-color: $x-loading-circle-border-bottom-color;
			border-left-color: $x-loading-circle-border-left-color;
			border-style: $x-loading-circle-border-style;
		}

		&--vertical {
			flex-direction: column
		}
	}

	// :host {
	// 	font-size: $x-loading-icon-host-font-size;
	// 	line-height: $x-loading-icon-host-line-height;
	// }

	.x-loading-icon__spinner--spinner {
			// todo2026 wait uni-app-x
			// #ifndef APP
			animation-timing-function: steps(12)
			// #endif
	}

	.x-loading-icon__text-vertical {
		margin: $x-loading-icon-vertical-margin;
		color: $x-content-color;
	}

	.x-loading-icon__dot {
			position: absolute;
			// top: $x-loading-icon-dot-top;
			// left: $x-loading-icon-dot-left;
			width: $x-loading-icon-dot-width;
			height: $x-loading-icon-dot-height;

			//&:before {
				width: $x-loading-icon-dot-before-width;
				height: $x-loading-icon-dot-before-height;
				// margin: $x-loading-icon-dot-before-margin;
				background-color: $x-loading-icon-dot-before-background-color;
				border-radius: $x-loading-icon-dot-before-border-radius;
			//}
	}

	$radius: v-bind(size)px;
	@for $i from 1 through 12 {
		// .x-loading-icon__dot:nth-of-type(#{$i}) {
		// 	transform: rotate(($i + 2) * 30deg);
