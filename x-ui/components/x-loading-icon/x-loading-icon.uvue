	$x-loading-height:30px !default;
	$x-loading-max-width:100% !default;
	$x-loading-max-height:100% !default;
	$x-loading-semicircle-border-width: 2px !default;
	$x-loading-semicircle-border-color:transparent !default;
	$x-loading-semicircle-border-top-right-radius: 100px !default;
	$x-loading-semicircle-border-top-left-radius: 100px !default;
	$x-loading-semicircle-border-bottom-left-radius: 100px !default;
	$x-loading-semicircle-border-bottom-right-radiu: 100px !default;
	$x-loading-semicircle-border-style: solid !default;
