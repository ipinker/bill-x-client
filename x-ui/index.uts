import config from './libs/config/config'
import color from './libs/config/color'
import { getBaseVars } from './tokens/presets'
import { buildCssVarsObject } from './tokens/utils'
import { setGlobalXkConfig } from './tokens/globalConfig'

function createRuntimeX() : UTSJSONObject {
  const vars = getBaseVars('light')
  return UTSJSONObject.assign(
    {},
    {
      config,
      color,
      type: ['primary', 'success', 'error', 'warning', 'info'],
      theme: 'light',
      themeMode: 'light',
      resolvedTheme: 'light',
      vars,
      themeVars: buildCssVarsObject(vars),
    } as UTSJSONObject,
  )
}

export function mountX() {
  const runtimeX = createRuntimeX()
  if (runtimeX['vars'] == null) {
    runtimeX['vars'] = getBaseVars('light')
  }
  runtimeX['themeVars'] = buildCssVarsObject(runtimeX['vars'] as UTSJSONObject)
  // #ifdef H5
  const uniRuntime = uni as any as UTSJSONObject
  uniRuntime['$x'] = runtimeX
  // #endif
  setGlobalXkConfig({
    theme: runtimeX['resolvedTheme'] != null ? runtimeX['resolvedTheme'] : 'light',
    themeMode: runtimeX['themeMode'] != null ? runtimeX['themeMode'] : 'light',
    themeVars: runtimeX['vars'],
  } as UTSJSONObject)
}


